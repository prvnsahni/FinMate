{
  "name": "@finmate/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "db:up": "docker compose up -d || docker-compose up -d",
    "db:down": "docker compose down || docker-compose down",
    "db:migrate": "npx ts-node --project backend/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d backend/src/ormconfig.ts",
    "db:migrate:revert": "npx ts-node --project backend/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d backend/src/ormconfig.ts",
    "start:dev": "npx nx serve backend",
    "setup": "npm run db:up && npm run db:migrate && npm run start:dev",
    "prepare": "husky"
  },
  "private": true,
  "supportedArchitectures": {
    "os": [
      "current",
      "linux"
    ],
    "cpu": [
      "current",
      "x64",
      "arm64"
    ]
  },
