# FinMate Environment Variables
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/finmate_dev
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your_32_byte_encryption_key_hex

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Branded sender: emails are sent as "MAIL_FROM_NAME <MAIL_FROM_EMAIL>".
MAIL_FROM_NAME=Finmate
MAIL_FROM_EMAIL=noreply@mail.prvnsahni.com
# Shown in the email footer for support enquiries (defaults to MAIL_FROM_EMAIL).
SUPPORT_EMAIL=
# Deprecated: superseded by MAIL_FROM_EMAIL, still read as a fallback.
FROM_EMAIL=noreply@mail.prvnsahni.com

# ── Frontend URL (used for CORS + invite links) ──────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── CORS (comma-separated origins, defaults to FRONTEND_URL if empty) ────────
CORS_ORIGINS=

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Expenses ──────────────────────────────────────────────────────────────────
# Day of the *following* month, inclusive, until which the previous month's
# group expenses stay editable. After this day the previous month is closed:
# its expenses become fully read-only and cannot be edited or deleted. The
# current month is always editable. Range 1–28 (clamped). Default 7.
MONTH_LOCK_DAY=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_LOGIN=5
THROTTLE_LIMIT_REGISTER=5
THROTTLE_LIMIT_FORGOT=3
THROTTLE_LIMIT_RESET=3
THROTTLE_LIMIT_OTP=5
THROTTLE_LIMIT_REFRESH=15
THROTTLE_LIMIT_IMPORT=10
THROTTLE_LIMIT_EXPORT=20

# ── Web Security (SEC-W5 / SEC-W9) ────────────────────────────────────────────
# Trust-proxy setting (SEC-W9). Controls how the real client IP is derived from
# X-Forwarded-For so it cannot be spoofed. If unset, defaults to `1` (trust
# exactly one reverse-proxy hop — non-spoofable). Set to the number of proxy
# hops in your real chain (e.g. 1 for a single nginx/ALB, 2 for Cloudflare+nginx),
# or a comma-separated list of trusted proxy IPs/CIDRs, or `false` to ignore
# forwarding headers entirely (direct exposure). Do NOT set `true` in production.
TRUST_PROXY=1
# Swagger `/docs` UI (SEC-W5). Omitted → served only when NODE_ENV != production.
# Set `true` to force-enable (e.g. a locked-down UAT host) or `false` to disable.
ENABLE_SWAGGER=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
